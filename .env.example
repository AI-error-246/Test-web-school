# Application
APP_NAME=InternBridge
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:3001
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
DEMO_MODE=false

# Sessions and runtime
SESSION_DRIVER=file
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
# Application status emails: preview stores private HTML; never sends mail.
APPLICATION_MAIL_MODE=preview
# Real SMTP is configured and verified separately before switching mode to send.
MAIL_MAILER=log
LOG_CHANNEL=single
LOG_LEVEL=warning

# Request guard is enabled by default. CV scans fail closed if the engine is unavailable.
TRAFFIC_GUARD_ENABLED=true
CV_SCAN_TIMEOUT=30
# Defaults: Windows Defender on Windows; /usr/bin/clamscan on Linux.
# CV_SCAN_ENGINE=defender
# CV_SCAN_EXECUTABLE="C:/Program Files/Windows Defender/MpCmdRun.exe"

# Supabase - keep cloud disabled until preparation and transfer are verified
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_DB_URL=
SUPABASE_DATA_ENABLED=false
SUPABASE_CV_DISK=local
SUPABASE_STORAGE_BUCKET=internship-cvs

# Local database - retained for backup and rollback
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=internship_dev
DB_USERNAME=internship_app
DB_PASSWORD=
DB_SSLMODE=disable

# Read-only local support assistant; no external AI API key or usage charge.
ASSISTANT_ENABLED=true
ASSISTANT_REQUESTS_PER_MINUTE=6
ASSISTANT_DAILY_REQUEST_LIMIT=100
